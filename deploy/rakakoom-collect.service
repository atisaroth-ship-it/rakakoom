[Unit]
Description=RakaKoom daily Shopee feed price collector
# postgresql.service on Ubuntu is only a wrapper; the cluster itself is postgresql@16-main.
After=network-online.target postgresql@16-main.service
Requires=postgresql@16-main.service
Wants=network-online.target
# Crash, OOM or timeout kill: the program cannot alert for itself, so systemd does.
OnFailure=rakakoom-failure@%n.service

[Service]
Type=oneshot
User=rakakoom
WorkingDirectory=/opt/rakakoom
EnvironmentFile=/etc/rakakoom.env
# 1 GB RAM: cap the Node heap so Postgres keeps its share.
Environment=NODE_OPTIONS=--max-old-space-size=384
ExecStart=/usr/bin/npm run --silent collect
# e2-micro is a shared-core VM; two ~4 GB files plus the apply step can take hours.
TimeoutStartSec=8h
Nice=5
